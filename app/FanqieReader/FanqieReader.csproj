<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <AssemblyName>FanqieReader</AssemblyName>
    <RootNamespace>FanqieReader</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Version>1.0.3</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <Product>番茄沉浸阅读器</Product>
    <Company>DSH</Company>
    <Description>轻量、极简、沉浸式的番茄小说网页阅读器</Description>
    <Copyright>仅供个人学习与阅读</Copyright>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- Do not ship XML doc comments / PDBs of referenced packages. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- 发布出来的可执行文件名（程序集仍叫 FanqieReader） -->
    <AppExeName>番茄沉浸阅读器.exe</AppExeName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="AngleSharp" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="WebAssets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="assets\icon.ico" />
  </ItemGroup>

  <!--
    应用名叫「番茄沉浸阅读器」，但程序集保持 ASCII 的 FanqieReader：
    发布后把 apphost（FanqieReader.exe）改名成中文名，其余文件（FanqieReader.dll /
    runtimeconfig.json / deps.json）保持原名，apphost 里内嵌的是 DLL 名，改名不受影响。
  -->
  <Target Name="RenameAppHost" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
    <PropertyGroup>
      <_PublishAppHost>$(PublishDir)$(AssemblyName).exe</_PublishAppHost>
      <_PublishAppHostRenamed>$(PublishDir)$(AppExeName)</_PublishAppHostRenamed>
    </PropertyGroup>
    <Move SourceFiles="$(_PublishAppHost)"
          DestinationFiles="$(_PublishAppHostRenamed)"
          Condition="Exists('$(_PublishAppHost)')"
          OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Renamed app host to $(_PublishAppHostRenamed)" />
  </Target>
</Project>
